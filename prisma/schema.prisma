generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Store {
  id              String   @id @default(cuid())
  name            String
  category        String
  categoryId      String
  image           String
  tagTv           String
  description     String
  offer           String
  rating          Float    @default(5.0)
  reviewsCount    Int      @default(0)
  neighborhood    String
  address         String
  phone           String
  whatsapp        String
  instagram       String
  featuredInShow  String
  discountCoupon  String?
  highlights      Json?
  isVerifiedTv    Boolean  @default(true)
  openingHours    String
  website         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Banner {
  id         String   @id @default(cuid())
  title      String
  subtitle   String
  badge      String
  ctaText    String
  ctaLink    String
  mediaType  String   @default("image")
  mediaUrl   String
  sponsor    String
  showName   String
  airTime    String
  order      Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Lead {
  id           String   @id @default(cuid())
  storeName    String
  ownerName    String
  segment      String
  phone        String
  whatsapp     String
  email        String
  neighborhood String
  message      String?
  planInterest String
  status       String   @default("novo")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model NewsArticle {
  id        String   @id @default(cuid())
  title     String
  summary   String
  content   String
  date      String
  readTime  String
  category  String
  image     String
  reporter  String
  createdAt DateTime @default(now())
}

model TvProgram {
  id          String   @id @default(cuid())
  title       String
  timeSlot    String
  anchor      String
  description String
  isLiveNow   Boolean  @default(false)
  thumbnail   String
  createdAt   DateTime @default(now())
}

